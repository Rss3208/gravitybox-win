<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- GravityBox Dark Design Tokens (Aligned with native/Design.swift & SDD 02-design.md §4.8.2) -->
    <Color x:Key="BackgroundColor">#1C1C1E</Color>
    <Color x:Key="CardColor">#242428</Color>
    <Color x:Key="SubCardColor">#2C2C31</Color>
    <Color x:Key="TrackColor">#38383E</Color>
    <Color x:Key="TextPrimaryColor">#F2F2F7</Color>
    <Color x:Key="TextSecondaryColor">#8E8E93</Color>
    <Color x:Key="TextMutedColor">#6E6E73</Color>
    <Color x:Key="AccentBlueColor">#3B82F6</Color>
    <Color x:Key="AccentBlueHoverColor">#60A5FA</Color>
    <Color x:Key="AccentBlueSoftColor">#243B82F6</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="SuccessSoftColor">#2434D399</Color>
    <Color x:Key="WarningTextColor">#FBBF24</Color>
    <Color x:Key="WarningSoftColor">#24FBBF24</Color>
    <Color x:Key="DangerTextColor">#FB7185</Color>
    <Color x:Key="DangerSoftColor">#24FB7185</Color>
    <Color x:Key="BorderColor">#16FFFFFF</Color>
    <Color x:Key="HoverSurfaceColor">#12FFFFFF</Color>
    <Color x:Key="SidebarBrushColor">#202024</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="SubCardBrush" Color="{StaticResource SubCardColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="{StaticResource AccentBlueHoverColor}" />
    <SolidColorBrush x:Key="AccentBlueSoftBrush" Color="{StaticResource AccentBlueSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{StaticResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarBrushColor}" />

    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="RadiusPopover">11</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI Variable, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
</ResourceDictionary>
