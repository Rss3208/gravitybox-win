<Window x:Class="GravityBox.App.Views.Dialogs.ShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无感启动快捷方式管理"
        Width="600"
        Height="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListView Grid.Row="0" ItemsSource="{Binding Shortcuts}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="位置" Width="90" DisplayMemberBinding="{Binding Location}" />
                    <GridViewColumn Header="名称" Width="120" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="已配置" Width="70" DisplayMemberBinding="{Binding HasDebugPort}" />
                    <GridViewColumn Header="参数" Width="260" DisplayMemberBinding="{Binding Arguments}" />
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="一键还原全部" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding RestoreAllShortcutsCommand}" />
            <Button Content="应用无感参数" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyAllShortcutsCommand}" />
        </StackPanel>
    </Grid>
</Window>
