<Window x:Class="GravityBox.App.Views.Dialogs.AccountPolicyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备用账号推荐策略"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="20">
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="启用备用账号推荐" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="当当前账号配额低于阈值时自动标出高余量候选账号" Style="{StaticResource SecondaryLabelStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <CheckBox x:Name="EnableSwitch" Grid.Column="1" Style="{StaticResource DesignSwitchStyle}" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Text="推荐策略" Style="{StaticResource SecondaryLabelStyle}" />
        <ComboBox x:Name="StrategyCombo" Margin="0,4,0,12" Padding="8,6">
            <ComboBoxItem Content="按列表优先级顺序 (priority)" Tag="priority" />
            <ComboBoxItem Content="轮询均衡使用 (round_robin)" Tag="round_robin" />
        </ComboBox>

        <TextBlock Text="当前账号保留阈值 (%) · 范围 1-98" Style="{StaticResource SecondaryLabelStyle}" />
        <TextBox x:Name="ReserveBox" Margin="0,4,0,12" Padding="8,6" />

        <TextBlock Text="候选账号最低余量 (%) · 须大于保留阈值" Style="{StaticResource SecondaryLabelStyle}" />
        <TextBox x:Name="MinCandidateBox" Margin="0,4,0,16" Padding="8,6" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
