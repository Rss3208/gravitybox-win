<Window x:Class="GravityBox.App.Views.Dialogs.UsageLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请求明细"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="搜索" Style="{StaticResource PrimaryButtonStyle}" Click="OnSearchClick" />
        </Grid>

        <ListView Grid.Row="2" ItemsSource="{Binding EventRows}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="时间" Width="130" DisplayMemberBinding="{Binding Timestamp}" />
                    <GridViewColumn Header="模型" Width="220" DisplayMemberBinding="{Binding Model}" />
                    <GridViewColumn Header="Token" Width="110" DisplayMemberBinding="{Binding TokensText}" />
                    <GridViewColumn Header="费用" Width="100" DisplayMemberBinding="{Binding CostText}" />
                    <GridViewColumn Header="来源" Width="160" DisplayMemberBinding="{Binding SourceId}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="上一页" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OnPrevPageClick" />
            <Button Content="下一页" Style="{StaticResource SecondaryButtonStyle}" Click="OnNextPageClick" />
        </StackPanel>
    </Grid>
</Window>
