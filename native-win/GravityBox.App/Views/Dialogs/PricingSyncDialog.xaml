<Window x:Class="GravityBox.App.Views.Dialogs.PricingSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="价格同步与历史重估"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding PricingStatusText}" Style="{StaticResource SecondaryLabelStyle}" Margin="0,0,0,8" />
        <TextBlock Text="{Binding RevaluePreviewSummary}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="检查远端价格" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding CheckPricingSyncCommand}" />
            <Button Content="预览重估" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding PreviewRevalueCommand}" />
            <Button Content="确认重估" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Command="{Binding ApplyRevalueCommand}" />
            <Button Content="回滚" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RollbackRevalueCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
