<UserControl x:Class="GravityBox.App.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="关于" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,14" />

            <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="GravityBox for Windows" Style="{StaticResource CardTitleStyle}" FontSize="18" />
                        <TextBlock Text="{Binding VersionText, StringFormat='版本 {0}'}" Style="{StaticResource SecondaryLabelStyle}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="检查更新" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Command="{Binding CheckUpdatesCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="启动时自动检查更新" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="默认关闭；开启后仅连接 GitHub Releases 官方接口" Style="{StaticResource SecondaryLabelStyle}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource DesignSwitchStyle}" IsChecked="{Binding AutoUpdateEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardContainerStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="本地数据目录" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource SecondaryLabelStyle}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="在文件资源管理器中显示" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RevealDataDirectoryCommand}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
