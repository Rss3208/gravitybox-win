<UserControl x:Class="GravityBox.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GravityBox.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,14" />

            <!-- Group 1: Antigravity 增强 -->
            <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Antigravity 增强" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="显示语言" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="同时决定 GravityBox 与 Antigravity 的界面语言，不改动官方应用" Style="{StaticResource SecondaryLabelStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource SubCardBrush}" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="简体中文"
                                             Style="{StaticResource SegmentedTabRadioStyle}"
                                             IsChecked="{Binding SelectedLanguage, Converter={StaticResource EqualsParamConverter}, ConverterParameter=zh-Hans, Mode=OneWay}"
                                             Click="OnLangZhClick" />
                                <RadioButton Content="跟随系统"
                                             Style="{StaticResource SegmentedTabRadioStyle}"
                                             IsChecked="{Binding SelectedLanguage, Converter={StaticResource EqualsParamConverter}, ConverterParameter=system, Mode=OneWay}"
                                             Click="OnLangSystemClick" />
                                <RadioButton Content="English"
                                             Style="{StaticResource SegmentedTabRadioStyle}"
                                             IsChecked="{Binding SelectedLanguage, Converter={StaticResource EqualsParamConverter}, ConverterParameter=en, Mode=OneWay}"
                                             Click="OnLangEnClick" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="无感启动快捷方式" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding ShortcutsSummaryText}" Style="{StaticResource SecondaryLabelStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="管理快捷方式…" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="OnOpenShortcutsClick" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="对话状态栏 (HUD)" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="在 Antigravity 对话输入区上方显示实时上下文与速率状态条" Style="{StaticResource SecondaryLabelStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource DesignSwitchStyle}" IsChecked="{Binding HudEnabled, Mode=TwoWay}" Click="OnHudToggleClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Group 2: 配额与计价 -->
            <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="配额与计价" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="配额自动刷新频率" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="定时静默刷新托管账号配额，默认手动刷新以节省请求" Style="{StaticResource SecondaryLabelStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource SubCardBrush}" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="手动"
                                             Style="{StaticResource SegmentedTabRadioStyle}"
                                             IsChecked="{Binding QuotaRefreshMinutes, Converter={StaticResource EqualsParamConverter}, ConverterParameter=0, Mode=OneWay}"
                                             Command="{Binding SelectQuotaRefreshMinutesCommand}"
                                             CommandParameter="0" />
                                <RadioButton Content="5 分钟"
                                             Style="{StaticResource SegmentedTabRadioStyle}"
                                             IsChecked="{Binding QuotaRefreshMinutes, Converter={StaticResource EqualsParamConverter}, ConverterParameter=5, Mode=OneWay}"
                                             Command="{Binding SelectQuotaRefreshMinutesCommand}"
                                             CommandParameter="5" />
                                <RadioButton Content="15 分钟"
                                             Style="{StaticResource SegmentedTabRadioStyle}"
                                             IsChecked="{Binding QuotaRefreshMinutes, Converter={StaticResource EqualsParamConverter}, ConverterParameter=15, Mode=OneWay}"
                                             Command="{Binding SelectQuotaRefreshMinutesCommand}"
                                             CommandParameter="15" />
                                <RadioButton Content="30 分钟"
                                             Style="{StaticResource SegmentedTabRadioStyle}"
                                             IsChecked="{Binding QuotaRefreshMinutes, Converter={StaticResource EqualsParamConverter}, ConverterParameter=30, Mode=OneWay}"
                                             Command="{Binding SelectQuotaRefreshMinutesCommand}"
                                             CommandParameter="30" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="API 价格与历史重估" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding PricingStatusText}" Style="{StaticResource SecondaryLabelStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="价格同步与重估…" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="OnOpenPricingClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Group 3: 系统与存储 -->
            <Border Style="{StaticResource CardContainerStyle}">
                <StackPanel>
                    <TextBlock Text="系统与存储" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="开机自动启动" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="登录 Windows 时自动在系统托盘驻留" Style="{StaticResource SecondaryLabelStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource DesignSwitchStyle}" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" Click="OnLaunchAtLoginClick" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="跟随 Antigravity 启停" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Antigravity 退出后自动停止本地服务并退出" Style="{StaticResource SecondaryLabelStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource DesignSwitchStyle}" IsChecked="{Binding SyncAntigravityLifecycle, Mode=TwoWay}" Click="OnLifecycleSyncClick" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="存储与维护" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding StorageSummaryText}" Style="{StaticResource SecondaryLabelStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开存储维护…" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="OnOpenMaintenanceClick" />
                        </Grid>
                        <controls:CacheCompositionBar Height="8"
                                                      RuntimeBytes="{Binding RuntimeCacheBytes}"
                                                      LogsBytes="{Binding LogsBytes}"
                                                      ProtectedBytes="{Binding ProtectedBytes}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
