<UserControl x:Class="GravityBox.App.Views.Pages.UsagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GravityBox.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="用量与费用" Style="{StaticResource PageTitleStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="请求明细" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OnOpenLogClick" />
                    <Button Content="刷新" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <!-- 4-Period Selector -->
            <Border Background="{DynamicResource SubCardBrush}" CornerRadius="9" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="今日" Style="{StaticResource SegmentedTabRadioStyle}" Command="{Binding SelectPeriodCommand}" CommandParameter="0" />
                    <RadioButton Content="7 天" Style="{StaticResource SegmentedTabRadioStyle}" Command="{Binding SelectPeriodCommand}" CommandParameter="1" />
                    <RadioButton Content="30 天" Style="{StaticResource SegmentedTabRadioStyle}" Command="{Binding SelectPeriodCommand}" CommandParameter="2" />
                    <RadioButton Content="全部" Style="{StaticResource SegmentedTabRadioStyle}" Command="{Binding SelectPeriodCommand}" CommandParameter="3" />
                </StackPanel>
            </Border>

            <!-- Top Cards -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardContainerStyle}">
                    <StackPanel>
                        <TextBlock Text="Token 总量" Style="{StaticResource SecondaryLabelStyle}" />
                        <TextBlock Text="{Binding TotalTokensText}" Style="{StaticResource TabularTextStyle}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,8" />
                        <controls:UsageTrendChart Height="110" Points="{Binding TrendPoints}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardContainerStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="等效费用" Style="{StaticResource SecondaryLabelStyle}" />
                            <TextBlock Text="{Binding EstimatedCostText}" Style="{StaticResource TabularTextStyle}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,8" />
                            <TextBlock Text="缓存命中率" Style="{StaticResource SecondaryLabelStyle}" />
                            <TextBlock Text="{Binding CacheHitRateText}" Style="{StaticResource TabularTextStyle}" FontSize="15" FontWeight="Medium" Margin="0,2,0,0" />
                        </StackPanel>
                        <controls:ModelDonutChart Grid.Column="1" Width="96" Height="96" Slices="{Binding DonutSlices}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Model Breakdown -->
            <Border Style="{StaticResource CardContainerStyle}">
                <StackPanel>
                    <TextBlock Text="模型用量明细" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ModelRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ModelName}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TokensText}" Style="{StaticResource TabularTextStyle}" FontSize="12.5" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{Binding RequestsText}" Style="{StaticResource TabularTextStyle}" FontSize="12.5" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding CostText}" Style="{StaticResource TabularTextStyle}" FontSize="12.5" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
