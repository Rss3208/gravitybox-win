<UserControl x:Class="GravityBox.App.Views.Pages.UsagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GravityBox.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Top Header Bar -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="用量与费用" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border Background="{DynamicResource SubCardBrush}" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="今日"
                                         Style="{StaticResource SegmentedTabRadioStyle}"
                                         IsChecked="{Binding SelectedPeriodIndex, Converter={StaticResource EqualsParamConverter}, ConverterParameter=0, Mode=OneWay}"
                                         Command="{Binding SelectPeriodCommand}"
                                         CommandParameter="0" />
                            <RadioButton Content="近 7 天"
                                         Style="{StaticResource SegmentedTabRadioStyle}"
                                         IsChecked="{Binding SelectedPeriodIndex, Converter={StaticResource EqualsParamConverter}, ConverterParameter=1, Mode=OneWay}"
                                         Command="{Binding SelectPeriodCommand}"
                                         CommandParameter="1" />
                            <RadioButton Content="近 30 天"
                                         Style="{StaticResource SegmentedTabRadioStyle}"
                                         IsChecked="{Binding SelectedPeriodIndex, Converter={StaticResource EqualsParamConverter}, ConverterParameter=2, Mode=OneWay}"
                                         Command="{Binding SelectPeriodCommand}"
                                         CommandParameter="2" />
                            <RadioButton Content="全部"
                                         Style="{StaticResource SegmentedTabRadioStyle}"
                                         IsChecked="{Binding SelectedPeriodIndex, Converter={StaticResource EqualsParamConverter}, ConverterParameter=3, Mode=OneWay}"
                                         Command="{Binding SelectPeriodCommand}"
                                         CommandParameter="3" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="导出 CSV" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OnExportCsvClick" />
                    <Button Content="请求明细" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OnOpenLogClick" />
                    <Button Content="刷新" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <!-- Error Banner -->
            <Border Background="{DynamicResource WarningSoftBrush}"
                    CornerRadius="12"
                    Padding="12,8"
                    Margin="0,0,0,12"
                    Visibility="{Binding ErrorBanner, Converter={StaticResource StringNotEmptyToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding ErrorBanner}" Foreground="{DynamicResource WarningTextBrush}" FontSize="12.5" TextWrapping="Wrap" />
            </Border>

            <!-- Primary Wide Token Usage & Trend Card (matches macOS usage.png) -->
            <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Token 用量" Style="{StaticResource CardTitleStyle}" />
                        <Border Grid.Column="1" Style="{StaticResource PillBadgeStyle}">
                            <TextBlock Text="{Binding TrendBadgeText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding TotalTokensText}"
                               Style="{StaticResource TabularTextStyle}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Margin="0,6,0,2" />
                    <TextBlock Text="{Binding TokenCompositionText}"
                               Style="{StaticResource SecondaryLabelStyle}"
                               Margin="0,0,0,12" />
                    <controls:UsageTrendChart Height="130" Points="{Binding TrendPoints}" />
                </StackPanel>
            </Border>

            <!-- 2-Column Middle Row: Cost Donut + Requests & Cache -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <!-- API Cost & Donut Legend -->
                <Border Grid.Column="0" Style="{StaticResource CardContainerStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="API 费用估算" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="含未定价模型部分"
                                           Style="{StaticResource SecondaryLabelStyle}"
                                           Visibility="{Binding HasUnpricedModels, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding EstimatedCostText}"
                                       Style="{StaticResource TabularTextStyle}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Donut Ring with Centered Amount -->
                            <Grid Grid.Column="0" Width="126" Height="126" VerticalAlignment="Center">
                                <controls:ModelDonutChart Width="126" Height="126" Slices="{Binding DonutSlices}" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding EstimatedCostText}"
                                               Style="{StaticResource TabularTextStyle}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="等效账单"
                                               Style="{StaticResource SecondaryLabelStyle}"
                                               FontSize="10.5"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Colored Model Legend -->
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding TopLegendRows}" VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding ModelName}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelName}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding SummaryRightText}" Style="{StaticResource TabularTextStyle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Requests & Cache Hit Card -->
                <Border Grid.Column="2" Style="{StaticResource CardContainerStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="请求与缓存" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="请求明细…" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11.5" Click="OnOpenLogClick" />
                        </Grid>

                        <Grid Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="请求总数" Style="{StaticResource SecondaryLabelStyle}" />
                                <TextBlock Text="{Binding TotalRequestsText}" Style="{StaticResource TabularTextStyle}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AvgTokensPerRequestText}"
                                       Style="{StaticResource SecondaryLabelStyle}"
                                       VerticalAlignment="Bottom" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                        <controls:QuotaMeterRow Title="缓存命中率"
                                                Percentage="{Binding CacheHitRatePct}"
                                                RemainingText="{Binding CacheHitRateText}"
                                                ResetText="{Binding CacheReadSummaryText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Model Breakdown Table Card -->
            <Border Style="{StaticResource CardContainerStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模型用量明细" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding ModelRows.Count, StringFormat='共 {0} 款模型'}" Style="{StaticResource SecondaryLabelStyle}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Header Columns -->
                    <Grid Margin="0,0,0,6" Visibility="{Binding HasModels, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模型" Style="{StaticResource SecondaryLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="Token" Style="{StaticResource SecondaryLabelStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="请求" Style="{StaticResource SecondaryLabelStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="占比" Style="{StaticResource SecondaryLabelStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="等效费用" Style="{StaticResource SecondaryLabelStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="当前时间范围暂无模型调用记录"
                               Style="{StaticResource SecondaryLabelStyle}"
                               Visibility="{Binding HasModels, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                               Margin="0,8,0,4" />

                    <ItemsControl ItemsSource="{Binding ModelRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding ModelName}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelName}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TokensText}" Style="{StaticResource TabularTextStyle}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding RequestsText}" Style="{StaticResource TabularTextStyle}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ShareText}" Style="{StaticResource TabularTextStyle}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="4" Text="{Binding CostText}" Style="{StaticResource TabularTextStyle}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
