<Window x:Class="GravityBox.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GravityBox"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="6,0,6,20">
                    <TextBlock Text="GravityBox"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="for Windows"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- 5 Navigation Items -->
                <StackPanel Grid.Row="1">
                    <RadioButton Content="{Binding NavOverviewText}"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 IsChecked="{Binding SelectedPageIndex, Converter={StaticResource EqualsParamConverter}, ConverterParameter=0, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="0" />
                    <RadioButton Content="{Binding NavAccountsText}"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 IsChecked="{Binding SelectedPageIndex, Converter={StaticResource EqualsParamConverter}, ConverterParameter=1, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="1" />
                    <RadioButton Content="{Binding NavUsageText}"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 IsChecked="{Binding SelectedPageIndex, Converter={StaticResource EqualsParamConverter}, ConverterParameter=2, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="2" />
                    <RadioButton Content="{Binding NavSettingsText}"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 IsChecked="{Binding SelectedPageIndex, Converter={StaticResource EqualsParamConverter}, ConverterParameter=3, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="3" />
                    <RadioButton Content="{Binding NavAboutText}"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 IsChecked="{Binding SelectedPageIndex, Converter={StaticResource EqualsParamConverter}, ConverterParameter=4, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="4" />
                </StackPanel>

                <!-- Bottom Action & Status Footnote -->
                <StackPanel Grid.Row="2">
                    <Button Content="{Binding OpenAntigravityText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,0,10"
                            Command="{Binding OpenAntigravityCommand}" />

                    <Border Background="{DynamicResource SubCardBrush}"
                            CornerRadius="8"
                            Padding="10,7">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Page Host -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Non-blocking message banner -->
            <Border Grid.Row="0"
                    Margin="20,16,20,0"
                    Padding="12,9"
                    CornerRadius="10"
                    Background="{DynamicResource WarningSoftBrush}"
                    Visibility="{Binding HasBanner, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding BannerMessage}"
                               Foreground="{DynamicResource WarningTextBrush}"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="12.5"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,2"
                            Command="{Binding DismissBannerCommand}" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Margin="20,16,20,20"
                            Content="{Binding CurrentPageViewModel}" />
        </Grid>
    </Grid>
</Window>
